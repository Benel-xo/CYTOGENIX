.workspace{max-width:1500px;margin:auto;padding:30px 34px 50px;color:#e8edf6}.header,.panelHead,.experimentHead{display:flex;justify-content:space-between;align-items:flex-start;gap:18px}.header{margin-bottom:20px}.eyebrow,.panelHead small{font-size:10px;letter-spacing:1.5px;color:#8ea6c5;font-weight:800}.header h1{font-size:32px;margin:8px 0}.header p,.panel p{color:#9eabc0;line-height:1.6}.secondary,.primary{border:1px solid #34465f;border-radius:8px;padding:10px 15px;background:#17263a;color:#e3ecf8;font-weight:700;cursor:pointer}.primary{background:#2457a3;border-color:#3976c9}.primary:disabled{opacity:.5}.notice{display:flex;flex-direction:column;gap:6px;padding:15px 18px;border:1px solid #67512b;background:#282316;border-radius:11px;color:#d8c9a6;margin-bottom:18px;font-size:13px}.notice b{color:#f2d49b}.hardware{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:18px}.hardware article,.panel{background:#111c2b;border:1px solid #26364b;border-radius:12px}.hardware article{padding:15px;display:flex;flex-direction:column;gap:7px}.hardware small,.metrics small{font-size:10px;letter-spacing:1px;color:#8294ac;font-weight:800}.hardware b{font-size:17px}.hardware span{font-size:11px;color:#8999ae}.panel{padding:20px;margin-bottom:17px}.panelHead{align-items:center;margin-bottom:13px}.panelHead h2{font-size:19px;margin:5px 0}.panelHead>span{font-size:11px;color:#91a3bb}.panel pre{white-space:pre-wrap;background:#0a1421;border:1px solid #26364b;border-radius:8px;padding:12px;color:#a9bfd9;font-size:12px}.dataset,.experiment{padding:13px;border:1px solid #2a3b51;background:#0d1725;border-radius:9px;margin-top:10px;display:flex;flex-direction:column;gap:7px}.dataset span,.dataset small,.experiment>small{font-size:11px;color:#9baac0}.form{display:grid;grid-template-columns:repeat(4,1fr);gap:13px;margin-top:15px}.form label{display:flex;flex-direction:column;gap:7px;color:#aab8ca;font-size:12px}.form input,.form select{background:#0a1421;color:#e5edf8;border:1px solid #34465e;border-radius:8px;padding:10px}.actions{display:flex;align-items:center;gap:13px;margin-top:17px;flex-wrap:wrap}.actions span,.caution{font-size:11px;color:#899bb3;line-height:1.6}.empty{padding:17px;border:1px dashed #3b4d65;border-radius:9px;color:#9baac0;font-size:13px;line-height:1.6}.experimentHead span{font-size:11px;color:#a8cbff;background:#1a3151;padding:5px 9px;border-radius:20px}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;margin:14px 0}.metrics div{background:#152338;border-radius:8px;padding:11px;display:flex;flex-direction:column;gap:7px}.metrics b{font-size:17px}.table{overflow-x:auto;border:1px solid #2c3d53;border-radius:8px}.row{display:grid;grid-template-columns:repeat(5,minmax(85px,1fr));gap:6px;padding:9px 11px;border-bottom:1px solid #26364b;font-size:11px;color:#c3cede}.row:first-child{background:#1a2a40;color:#9fb4ce}.error,.message{padding:11px 14px;border-radius:8px;margin:12px 0;font-size:13px;background:#3a2026;color:#ffc1c1}.message{background:#18372e;color:#b4e8ca}footer{text-align:center;color:#70839b;font-size:10px;padding:18px 0}@media(max-width:850px){.hardware,.form,.metrics{grid-template-columns:repeat(2,1fr)}.header{flex-direction:column}}@media(max-width:520px){.workspace{padding:20px 13px}.hardware,.form,.metrics{grid-template-columns:1fr}}
